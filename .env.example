# HappyOyster needs one thing configured: your Reactor API key.

# ── Required ─────────────────────────────────────────────────────────────────

# Your Reactor account API key, starts with rk_. Server-side only — the
# app/api/reactor/token route exchanges it for short-lived browser JWTs, so the
# key itself never ships to the browser.
# Get one at https://www.reactor.inc/account/api-keys
REACTOR_API_KEY=rk_your_api_key_here

# ── Local development only ───────────────────────────────────────────────────

# Point the app at a different Reactor API. Defaults to https://api.reactor.inc.
# NEXT_PUBLIC_REACTOR_API_URL=

# Talk straight to a happy-oyster model served by the Reactor runtime (adventure
# on :8080, directing on :8081), skipping the Reactor API: no REACTOR_API_KEY and
# no JWT exchange.
# NEXT_PUBLIC_HO_LOCAL_RUNTIME=1

# ── Agents (optional) ────────────────────────────────────────────────────────

# OpenAI key for the Director and Concierge agents (app/api/agent/*). Server-side
# only. Without it the world app still works; the agents report the missing key.
# OPEN_AI_KEY=sk-...

# Override the agents' models. AGENT_MODEL runs the Concierge (one call per
# thing you say, uses web search); AGENT_FAST_MODEL runs the Director's
# every-few-seconds look at the stream, so keep it cheap.
# AGENT_MODEL=gpt-6.1-sol
# AGENT_FAST_MODEL=gpt-6-luna
